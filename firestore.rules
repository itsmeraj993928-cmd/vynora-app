rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (request.auth.token.role == 'ADMIN' ||
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'ADMIN');
    }

    // true when the signed-in person is a member of the chat
    function isChatMember(chatId) {
      return isAuthenticated() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participantIds;
    }

    // a counter that changes by exactly +1 or -1
    function stepsByOne(field) {
      return request.resource.data.get(field, 0) == resource.data.get(field, 0) + 1 ||
             request.resource.data.get(field, 0) == resource.data.get(field, 0) - 1;
    }

    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();

      // Follow / unfollow: the other person's follower counter may move by exactly 1
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followersCount']) &&
        stepsByOne('followersCount');

      // Which posts / reels I liked: only I can read or write my own list
      match /likedPosts/{postId} {
        allow read, write: if isOwner(userId);
      }
      match /likedClips/{clipId} {
        allow read, write: if isOwner(userId);
      }

      allow create: if isOwner(userId) &&
        request.resource.data.id == userId &&
        request.resource.data.badgeActive == false &&
        request.resource.data.badgeExpiry == 0 &&
        request.resource.data.badgeSource == "" &&
        request.resource.data.referralCount == 0 &&
        request.resource.data.role == "USER" &&
        request.resource.data.isOfficial == false &&
        request.resource.data.isBanned == false;

      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isOwner(userId) &&
          // Normal users cannot tamper with privileged badge, role, or referral fields
          request.resource.data.badgeActive == resource.data.badgeActive &&
          request.resource.data.badgeExpiry == resource.data.badgeExpiry &&
          request.resource.data.badgeSource == resource.data.badgeSource &&
          request.resource.data.referralCount == resource.data.referralCount &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.isOfficial == resource.data.isOfficial &&
          request.resource.data.isBanned == resource.data.isBanned &&
          request.resource.data.get('restrictedUntil', 0) == resource.data.get('restrictedUntil', 0) &&
          // Full name can only be changed once every 14 days (enforced on the server too)
          (
            (request.resource.data.fullName == resource.data.fullName &&
             request.resource.data.get('nameLastChangedAt', 0) == resource.data.get('nameLastChangedAt', 0))
            ||
            (request.resource.data.fullName != resource.data.fullName &&
             request.time.toMillis() - resource.data.get('nameLastChangedAt', 0) >= 1209600000 &&
             request.resource.data.get('nameLastChangedAt', 0) >= request.time.toMillis() - 600000 &&
             request.resource.data.get('nameLastChangedAt', 0) <= request.time.toMillis() + 600000)
          )
        )
      );

      allow delete: if isAdmin() || isOwner(userId);

      // Private user fields (e.g. mobile number and date of birth) strictly private to the owner
      match /private/{document} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Usernames uniqueness lookup
    match /usernames/{username} {
      allow read: if true;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Phone numbers uniqueness lookup
    match /phones/{phone} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // Posts
    match /posts/{postId} {
      allow read: if isAuthenticated();
      // Anyone signed in may add exactly +1 to a post's view counter
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount']) && request.resource.data.get('viewsCount', 0) == resource.data.get('viewsCount', 0) + 1;
      // Likes and comments by other people: the like counter moves by 1, the comment list grows or shrinks by at most 1
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'comments', 'commentsCount']) &&
        (!('likesCount' in request.resource.data.diff(resource.data).affectedKeys()) || stepsByOne('likesCount')) &&
        (!('comments' in request.resource.data.diff(resource.data).affectedKeys()) ||
          (request.resource.data.comments.size() - resource.data.get('comments', []).size()) in [-1, 0, 1]);
      allow create: if isAuthenticated() && request.resource.data.get('authorId', request.resource.data.get('author', {}).get('id', '')) == request.auth.uid;
      allow update: if (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount']) && request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1) || isAuthenticated() && (resource.data.get('authorId', resource.data.get('author', {}).get('id', '')) == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.get('authorId', resource.data.get('author', {}).get('id', '')) == request.auth.uid || isAdmin());

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && request.resource.data.get('authorId', request.resource.data.get('author', {}).get('id', '')) == request.auth.uid;
        allow update, delete: if isAuthenticated() && (
          resource.data.get('authorId', resource.data.get('author', {}).get('id', '')) == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid ||
          isAdmin()
        );
      }
    }

    // Clips
    match /clips/{clipId} {
      allow read: if isAuthenticated();
      // Anyone signed in may add exactly +1 to a reel's view counter
      allow update: if isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount']) && request.resource.data.get('viewsCount', 0) == resource.data.get('viewsCount', 0) + 1;
      // Likes and comments by other people on reels
      allow update: if isAuthenticated() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likesCount', 'comments', 'commentsCount']) &&
        (!('likesCount' in request.resource.data.diff(resource.data).affectedKeys()) || stepsByOne('likesCount')) &&
        (!('comments' in request.resource.data.diff(resource.data).affectedKeys()) ||
          (request.resource.data.comments.size() - resource.data.get('comments', []).size()) in [-1, 0, 1]);
      allow create: if isAuthenticated() && request.resource.data.get('authorId', request.resource.data.get('author', {}).get('id', '')) == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.get('authorId', resource.data.get('author', {}).get('id', '')) == request.auth.uid || isAdmin());
      allow update: if (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount']) && request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1) || isAuthenticated() && (resource.data.get('authorId', resource.data.get('author', {}).get('id', '')) == request.auth.uid || isAdmin());
    }

    // Moments
    match /moments/{momentId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.get('authorId', request.resource.data.get('author', {}).get('id', '')) == request.auth.uid;
      allow delete: if isAuthenticated() && (resource.data.get('authorId', resource.data.get('author', {}).get('id', '')) == request.auth.uid || isAdmin());
      allow update: if (isAuthenticated() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reportCount']) && request.resource.data.reportCount == resource.data.get('reportCount', 0) + 1) || isAuthenticated() && (resource.data.get('authorId', resource.data.get('author', {}).get('id', '')) == request.auth.uid || isAdmin());

      // Story poll votes: one vote per person (doc id = voter id)
      match /votes/{voterId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && voterId == request.auth.uid;
        allow delete: if isAdmin();
      }

      // Story viewers: anyone signed in may record their OWN view; everyone signed in can read the list
      match /viewers/{viewerId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() && viewerId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    // Chats
    match /chats/{chatId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.participantIds);
      // 1-to-1 chats: members may update. Groups: the admin cannot be replaced, a member may only remove
      // themselves, and only the admin may add people.
      allow update: if isAuthenticated() && (isAdmin() || (request.auth.uid in resource.data.participantIds && (
        resource.data.get('isGroup', false) == false ||
        (request.resource.data.get('adminId', '') == resource.data.get('adminId', '') &&
         request.resource.data.get('isGroup', false) == true &&
         (request.resource.data.participantIds == resource.data.participantIds ||
          (!(request.auth.uid in request.resource.data.participantIds) &&
           request.resource.data.participantIds.size() == resource.data.participantIds.size() - 1 &&
           resource.data.participantIds.hasAll(request.resource.data.participantIds)) ||
          (resource.data.get('adminId', '') == request.auth.uid &&
           request.resource.data.participantIds.hasAll(resource.data.participantIds))))
      )));

      match /messages/{messageId} {
        // only people inside the chat can read or send its messages
        allow read: if isAuthenticated() && (isChatMember(chatId) || isAdmin());
        allow create: if isAuthenticated() && request.resource.data.senderId == request.auth.uid && isChatMember(chatId);
        allow update, delete: if isAuthenticated() && (resource.data.senderId == request.auth.uid || isAdmin());
      }
    }

    // Appeals (a banned user can write only their own appeal; admins review)
    match /appeals/{appealId} {
      allow create, update: if isAuthenticated() && (
        (request.resource.data.userId == request.auth.uid && request.resource.data.status == 'PENDING') || isAdmin());
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Admin audit log
    match /auditLogs/{logId} {
      allow create: if isAdmin();
      allow read: if isAdmin();
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
      // a notification must carry the sender's own identity (nobody can fake someone else)
      allow create: if isAuthenticated() && (request.resource.data.get('user', {}).get('id', '') == request.auth.uid || isAdmin());
      allow update, delete: if isAuthenticated() && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // Reports
    match /reports/{reportId} {
      allow create: if isAuthenticated() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Follows, Likes, Saves
    match /follows/{followId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated() && (
        request.resource.data.followerId == request.auth.uid ||
        resource.data.followerId == request.auth.uid ||
        isAdmin()
      );
    }

    match /likes/{likeId} {
      allow read: if isAuthenticated();
      allow create, delete: if isAuthenticated() && (
        request.resource.data.userId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    match /saves/{saveId} {
      allow read, delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    // Voice / video calls: only the two people in the call
    match /calls/{callId} {
      allow create: if isAuthenticated() && request.resource.data.callerId == request.auth.uid;
      allow read, update: if isAuthenticated() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.calleeId == request.auth.uid
      );
      allow delete: if isAdmin();
    }
  }
}
